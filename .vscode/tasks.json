{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/Instance.cpp",
                "${workspaceFolder}/Solution.cpp",
                "${workspaceFolder}/SolutionInitiale.cpp",
                "${workspaceFolder}/NearestNeighbor.cpp",
                "${workspaceFolder}/Checker.cpp",
                "-o",
                "${workspaceFolder}/output/main"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}